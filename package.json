{
  "name": "ghoti-extension",
  "version": "0.1.0",
  "description": "My Chrome Extension",
  "private": true,
  "scripts": {
    "watch": "webpack --mode=development --watch --config config/webpack.config.js",
    "build": "npm run build:firefox",
    "build:firefox": "TARGET_BROWSER=firefox webpack --mode=production --config config/webpack.config.js",
    "build:chrome": "TARGET_BROWSER=chrome webpack --mode=production --config config/webpack.config.js",
    "pack": "node pack.js",
    "repack": "npm run build && npm run pack",
    "format": "prettier --write --ignore-unknown \"{config,public,src}/**/*.{html,css,js,ts,json}\""
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "baseline-browser-mapping": "^2.9.17",
    "copy-webpack-plugin": "^10.2.4",
    "css-loader": "^6.11.0",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier": "^2.8.8",
    "terser-webpack-plugin": "^5.3.16",
    "webpack": "^5.102.1",
    "webpack-cli": "^4.10.0",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "file:./src/web-llm",
    "acorn": "^8.14.0",
    "htmlparser2": "^9.1.0",
    "perf_hooks": "^0.0.1",
    "postcss": "^8.4.49",
    "url": "^0.11.4"
  }
}